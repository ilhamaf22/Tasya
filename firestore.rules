rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PIN admin disimpan di dokumen admin/secret (field "pin", tipe string).
    function secretPin() {
      return get(/databases/$(database)/documents/admin/secret).data.pin;
    }

    // Tiket harus baru dibuat di penyimpanan yang sama, supaya tiket lama tidak bisa dipakai ulang.
    function freshTicket(id) {
      return id is string
        && !exists(/databases/$(database)/documents/tickets/$(id))
        && existsAfter(/databases/$(database)/documents/tickets/$(id));
    }

    // Tempat PIN: tidak bisa dibaca atau diubah dari website
    match /admin/{docId} {
      allow read, write: if false;
    }

    // Tiket hanya bisa dibuat kalau PIN-nya benar, dan tidak bisa dibaca
    match /tickets/{ticketId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.pin == secretPin();
    }

    // Isi halaman: semua boleh membaca, menulis butuh tiket ber-PIN benar
    match /site/{docId} {
      allow read: if true;
      allow create, update: if freshTicket(request.resource.data.ticket);
    }

    // Foto galeri
    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if freshTicket(request.resource.data.ticket);
    }
  }
}
