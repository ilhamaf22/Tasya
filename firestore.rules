rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ganti dengan email akun admin yang sama dengan ADMIN_EMAIL di firebase-config.js
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "emailkamu@gmail.com";
    }

    // Isi halaman: siapa pun boleh membaca, hanya admin yang boleh mengubah
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Foto galeri (disimpan sebagai data URL, maksimal ~1 MB per dokumen)
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Selain itu, tutup semuanya
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
